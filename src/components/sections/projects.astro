---
import { featuredProjects } from "@/data/projects"
import { getTranslations, type Locale } from "@/i18n"
import pkg from "lucide-react"
const { Code, ExternalLink } = pkg

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="projects" class="py-16 lg:py-24">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">
    <h2 class="text-3xl font-semibold tracking-[-0.03em] lg:text-[3rem]">
      {t.projects.title}
    </h2>

    <div>
      {
        featuredProjects.map((project) => (
          <article class="rule grid grid-cols-1 gap-4 py-8 lg:grid-cols-12 lg:gap-8">
            <h3 class="text-xl font-semibold text-foreground lg:col-span-4">
              {project.title}
            </h3>
            <div class="lg:col-span-8">
              <p class="measure text-sm leading-relaxed text-muted-foreground">
                {locale === "en" && project.descriptionEn
                  ? project.descriptionEn
                  : project.description}
              </p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.stack.map((tech) => (
                  <li class="rounded-sm border border-border px-2 py-1 text-xs text-muted-foreground">
                    {tech}
                  </li>
                ))}
              </ul>
              <div class="mt-6 flex flex-wrap gap-3">
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-2 border-b border-border text-sm text-foreground transition-colors hover:border-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                  >
                    <Code width="16" height="16" aria-hidden="true" />
                    {t.projects.viewCode}
                  </a>
                )}
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-2 border-b border-border text-sm text-foreground transition-colors hover:border-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                  >
                    <ExternalLink width="16" height="16" aria-hidden="true" />
                    {t.projects.demo}
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <a
      href="https://github.com/minn09"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex min-h-11 items-center gap-2 border-b border-border text-sm text-muted-foreground transition-colors hover:border-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
    >
      {t.projects.viewMoreOnGithub}
      <ExternalLink width="14" height="14" aria-hidden="true" />
    </a>
  </div>
</section>
