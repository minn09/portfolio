---
import { experience } from "@/data/experience"
import { getTranslations, type Locale } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="experience" class="py-10">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="mb-8 text-2xl font-semibold">{t.experience.title}</h2>

    <ol class="border-l border-border">
      {
        experience.map((exp) => (
          <li class="relative pb-8 pl-6 last:pb-0">
            <span
              class="absolute top-1.5 -left-[5px] size-2.5 rounded-full bg-foreground ring-4 ring-background"
              aria-hidden="true"
            />
            <h3 class="font-heading text-base leading-snug font-medium">
              {locale === "en" && exp.roleEn ? exp.roleEn : exp.role}
            </h3>
            <p class="text-sm text-muted-foreground">
              {locale === "en" && exp.companyEn ? exp.companyEn : exp.company}
              {" · "}
              {locale === "en" && exp.locationEn
                ? exp.locationEn
                : exp.location}
            </p>
            <p class="mt-1 text-xs text-muted-foreground">
              {locale === "en" && exp.periodEn ? exp.periodEn : exp.period}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
