---
import { experience } from "@/data/experience"
import { getTranslations, type Locale } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="experience" class="py-16 lg:py-24">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">
    <h2 class="text-3xl font-semibold tracking-[-0.03em] lg:text-[3rem]">
      {t.experience.title}
    </h2>

    <ol>
      {
        experience.map((exp) => (
          <li class="rule grid grid-cols-1 gap-2 py-8 lg:grid-cols-12 lg:gap-8">
            <div class="lg:col-span-5">
              <h3 class="text-xl font-semibold text-foreground">
                {locale === "en" && exp.roleEn ? exp.roleEn : exp.role}
              </h3>
              <p class="text-sm text-muted-foreground">
                {locale === "en" && exp.companyEn ? exp.companyEn : exp.company}
                <span aria-hidden="true">{" / "}</span>
                {locale === "en" && exp.locationEn
                  ? exp.locationEn
                  : exp.location}
              </p>
            </div>
            <p class="tabular text-xs text-muted-foreground lg:col-span-7 lg:text-right">
              {locale === "en" && exp.periodEn ? exp.periodEn : exp.period}
            </p>
            <div class="lg:col-span-12">
              <p class="text-sm">
                {locale === "en" && exp.highlightEn
                  ? exp.highlightEn
                  : exp.highlight}
              </p>

              <details class="mt-2">
                <summary class="cursor-pointer text-sm text-foreground underline-offset-4 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                  {t.experience.seeAll}
                </summary>
                <ul class="mt-3 list-disc space-y-2 pl-6 text-sm text-muted-foreground">
                  {(locale === "en" && exp.descriptionEn
                    ? exp.descriptionEn
                    : exp.description
                  ).map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </details>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
