---
import { personalInfo } from "@/data/personal"
import { getTranslations, type Locale } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="hero" class="flex min-h-screen items-center justify-center pt-16">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <p class="mb-4 text-sm text-muted-foreground">
      {t.hero.greeting}
    </p>

    <h1 class="mb-4 text-4xl font-bold md:text-6xl">
      {personalInfo.fullName}
    </h1>

    <p class="mb-8 text-xl text-muted-foreground">
      {t.hero.role}
    </p>

    <p class="mx-auto mb-8 max-w-xl text-muted-foreground">
      {t.about.bio}
    </p>

    <div class="flex items-center justify-center gap-4">
      <a
        href="#projects"
        class="rounded-md bg-foreground px-6 py-3 font-medium text-background transition-opacity hover:opacity-90"
      >
        {t.hero.viewProjects}
      </a>
      <a
        href="#contact"
        class="rounded-md border border-border px-6 py-3 font-medium transition-colors hover:bg-accent"
      >
        {t.hero.contactMe}
      </a>
    </div>

    <!-- Scroll Arrow -->
    <div class="mt-8 animate-bounce md:mt-16">
      <div class="flex flex-col items-center text-center">
        <span class="mb-2 text-sm text-muted-foreground">Scroll</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </div>
    </div>
  </div>
</section>
