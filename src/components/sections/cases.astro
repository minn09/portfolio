---
import { caseStudies } from "@/data/cases"
import { getTranslations, type Locale } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="cases" class="py-16 lg:py-24">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">
    <div class="mb-12">
      <h2 class="text-3xl font-semibold tracking-[-0.03em] lg:text-[3rem]">
        {t.cases.title}
      </h2>
      <p class="measure mt-4 text-muted-foreground">{t.cases.subtitle}</p>
    </div>

    <div class="space-y-16">
      {
        caseStudies.map((study) => (
          <article>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h3 class="text-xl font-semibold text-foreground lg:text-2xl">
                  {locale === "en" ? study.titleEn : study.title}
                </h3>
                <p class="mt-2 text-sm text-muted-foreground">
                  {locale === "en" ? study.contextEn : study.context}
                </p>
              </div>
            </div>

            <dl class="mt-8">
              <div class="rule py-6">
                <dt class="text-xs text-muted-foreground">{t.cases.problem}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-foreground/90">
                  {locale === "en" ? study.problemEn : study.problem}
                </dd>
              </div>
              <div class="rule py-6">
                <dt class="text-xs text-muted-foreground">{t.cases.action}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-foreground/90">
                  {locale === "en" ? study.actionEn : study.action}
                </dd>
              </div>
              <div class="rule py-6">
                <dt class="text-xs text-muted-foreground">{t.cases.result}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-foreground/90">
                  {locale === "en" ? study.resultEn : study.result}
                </dd>
              </div>
            </dl>

            <ul class="mt-6 flex flex-wrap gap-2">
              {study.stack.map((tech) => (
                <li class="rounded-sm border border-border px-2 py-1 text-xs text-muted-foreground">
                  {tech}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
