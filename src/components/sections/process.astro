---
import { processSteps } from "@/data/process"
import { getTranslations, type Locale } from "@/i18n"
import { Card, CardContent } from "@/components/ui/card"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="process" class="bg-muted/30 py-10">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="mb-2 text-2xl font-semibold">{t.process.title}</h2>
    <p class="mb-8 max-w-2xl text-muted-foreground">{t.process.subtitle}</p>

    <ol class="grid grid-cols-1 gap-6 md:grid-cols-4">
      {
        processSteps.map((step, index) => (
          <li>
            <Card size="sm" className="h-full">
              <CardContent>
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-secondary text-sm font-medium text-secondary-foreground"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <h3 class="mt-3 font-heading text-base leading-snug font-medium">
                  {locale === "en" ? step.titleEn : step.title}
                </h3>
                <p class="mt-2 text-sm text-muted-foreground">
                  {locale === "en" ? step.descriptionEn : step.description}
                </p>
              </CardContent>
            </Card>
          </li>
        ))
      }
    </ol>
  </div>
</section>
