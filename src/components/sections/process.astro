---
import { processSteps } from "@/data/process"
import { getTranslations, type Locale } from "@/i18n"
import { Card, CardContent } from "@/components/ui/card"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="process" class="py-16 lg:py-24">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">
    <div class="mb-12">
      <h2 class="text-3xl font-semibold tracking-[-0.03em] lg:text-[3rem]">
        {t.process.title}
      </h2>
      <p class="measure mt-4 text-muted-foreground">{t.process.subtitle}</p>
    </div>

    <ol class="grid grid-cols-1 lg:grid-cols-4">
      {
        processSteps.map((step, index) => (
          <li class="py-8 lg:border-l lg:border-border lg:pl-8 lg:first:border-l-0 lg:first:pl-0">
            <div class="rule mb-6 lg:hidden" aria-hidden="true" />
            <p class="tabular text-xs text-muted-foreground">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 text-lg font-semibold text-foreground">
              {locale === "en" ? step.titleEn : step.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {locale === "en" ? step.descriptionEn : step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
