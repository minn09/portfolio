---
import { getTranslations, type Locale } from "@/i18n"
import pkg from "lucide-react"
const { Gauge, Layers, Users, MapPin } = pkg

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)

const values = [
  {
    icon: Gauge,
    title: t.about.values.performanceTitle,
    text: t.about.values.performanceText,
  },
  {
    icon: Layers,
    title: t.about.values.architectureTitle,
    text: t.about.values.architectureText,
  },
  {
    icon: Users,
    title: t.about.values.collaborationTitle,
    text: t.about.values.collaborationText,
  },
]
---

<section id="about" class="py-16 lg:py-24">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="measure lg:col-span-5">
        <h2
          class="text-3xl leading-[1.05] font-semibold text-balance text-foreground"
        >
          {t.about.title}
        </h2>
        <p
          class="mt-6 text-lg leading-relaxed text-pretty text-muted-foreground"
        >
          {t.about.lead}
        </p>
        <p class="mt-6 flex items-center gap-2 text-sm text-muted-foreground">
          <MapPin
            className="size-6 shrink-0 text-foreground"
            strokeWidth={1.5}
            aria-hidden="true"
          />
          {t.common.basedIn}
        </p>
      </div>

      <ul class="lg:col-span-7">
        {
          values.map(({ icon: Icon, title, text }) => (
            <li class="rule flex gap-4 py-6">
              <Icon
                className="size-6 shrink-0 text-foreground"
                strokeWidth={1.5}
                aria-hidden="true"
              />
              <div>
                <h3 class="text-lg font-semibold text-foreground">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-pretty text-muted-foreground">
                  {text}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
