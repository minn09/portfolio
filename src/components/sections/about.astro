---
import { getTranslations, type Locale } from "@/i18n"
import { Card, CardContent } from "@/components/ui/card"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)

const values = [
  {
    title: t.about.values.performanceTitle,
    text: t.about.values.performanceText,
  },
  {
    title: t.about.values.architectureTitle,
    text: t.about.values.architectureText,
  },
  {
    title: t.about.values.collaborationTitle,
    text: t.about.values.collaborationText,
  },
]
---

<section id="about" class="py-10">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="mb-8 text-2xl font-semibold">{t.about.title}</h2>

    <Card>
      <CardContent className="p-6">
        <p class="leading-relaxed text-muted-foreground">{t.about.lead}</p>
        <p class="mt-4 text-sm text-muted-foreground">{t.common.basedIn}</p>
      </CardContent>
    </Card>

    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        values.map((value) => (
          <Card size="sm">
            <CardContent>
              <h3 class="font-heading text-base leading-snug font-medium">
                {value.title}
              </h3>
              <p class="mt-2 text-sm text-muted-foreground">{value.text}</p>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </div>
</section>
