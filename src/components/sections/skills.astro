---
import { skills } from "@/data/skills"
import { getTranslations, type Locale } from "@/i18n"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="skills" class="bg-muted/30 py-16">
  <div class="mx-auto max-w-4xl px-6">
    <div class="mb-10 text-center md:text-left">
      <h2 class="text-3xl font-bold tracking-tight">{t.skills.title}</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Tecnologías y herramientas que utilizo habitualmente en el desarrollo.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <!-- Frontend -->
      <Card className="transition-all hover:border-foreground/20">
        <CardHeader className="pb-3">
          <CardTitle className="text-lg font-semibold"
            >{t.skills.frontend}</CardTitle
          >
        </CardHeader>
        <CardContent>
          <div class="flex flex-wrap gap-2">
            {
              skills.frontend.map((skill) => (
                <span class="cursor-default rounded-full bg-secondary px-3 py-1 text-xs font-medium text-secondary-foreground transition-all hover:bg-foreground hover:text-background">
                  {skill}
                </span>
              ))
            }
          </div>
        </CardContent>
      </Card>

      <!-- Backend -->
      <Card className="transition-all hover:border-foreground/20">
        <CardHeader className="pb-3">
          <CardTitle className="text-lg font-semibold"
            >{t.skills.backend}</CardTitle
          >
        </CardHeader>
        <CardContent>
          <div class="flex flex-wrap gap-2">
            {
              skills.backend.map((skill) => (
                <span class="cursor-default rounded-full bg-secondary px-3 py-1 text-xs font-medium text-secondary-foreground transition-all hover:bg-foreground hover:text-background">
                  {skill}
                </span>
              ))
            }
          </div>
        </CardContent>
      </Card>

      <!-- Tools -->
      <Card className="transition-all hover:border-foreground/20">
        <CardHeader className="pb-3">
          <CardTitle className="text-lg font-semibold"
            >{t.skills.tools}</CardTitle
          >
        </CardHeader>
        <CardContent>
          <div class="flex flex-wrap gap-2">
            {
              skills.tools.map((skill) => (
                <span class="cursor-default rounded-full bg-secondary px-3 py-1 text-xs font-medium text-secondary-foreground transition-all hover:bg-foreground hover:text-background">
                  {skill}
                </span>
              ))
            }
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</section>
