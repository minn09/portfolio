---
import { skills } from "@/data/skills"
import { getTranslations, type Locale } from "@/i18n"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<section id="skills" class="bg-muted/30 py-24">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="mb-8 text-2xl font-semibold">{t.skills.title}</h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <Card>
        <CardHeader>
          <CardTitle className="text-lg">{t.skills.frontend}</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="flex flex-wrap gap-2">
            {
              skills.frontend.map((skill) => (
                <span class="rounded-full bg-secondary px-3 py-1 text-sm text-secondary-foreground">
                  {skill}
                </span>
              ))
            }
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="text-lg">{t.skills.backend}</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="flex flex-wrap gap-2">
            {
              skills.backend.map((skill) => (
                <span class="rounded-full bg-secondary px-3 py-1 text-sm text-secondary-foreground">
                  {skill}
                </span>
              ))
            }
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="text-lg">{t.skills.tools}</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="flex flex-wrap gap-2">
            {
              skills.tools.map((skill) => (
                <span class="rounded-full bg-secondary px-3 py-1 text-sm text-secondary-foreground">
                  {skill}
                </span>
              ))
            }
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</section>
