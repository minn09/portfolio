---
import { personalInfo } from "@/data/personal"
import { getTranslations, type Locale } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)

const navLinks = [
  { href: "#about", label: t.nav.about },
  { href: "#services", label: t.nav.services },
  { href: "#cases", label: t.nav.cases },
  { href: "#projects", label: t.nav.projects },
  { href: "#skills", label: t.nav.skills },
  { href: "#contact", label: t.nav.contact },
]
---

<header
  class="fixed top-0 right-0 left-0 z-50 h-16 border-b border-border bg-background/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-6 lg:px-10"
  >
    <a
      href="/"
      class="text-base font-medium text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring lg:text-lg"
    >
      {personalInfo.name}
    </a>

    <div class="flex items-center gap-3 lg:gap-6">
      <!-- Navegación de Escritorio -->
      <ul class="hidden items-center gap-4 text-sm md:flex lg:gap-6">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-10 items-center text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Language Switcher -->
      <div class="flex items-center gap-1">
        <a
          href="/"
          aria-current={locale === "es" ? "page" : undefined}
          class={`inline-flex min-h-11 items-center rounded-sm px-2.5 py-1 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring ${
            locale === "es"
              ? "bg-secondary text-secondary-foreground"
              : "text-muted-foreground hover:text-foreground"
          }`}
        >
          ES
        </a>
        <a
          href="/en"
          aria-current={locale === "en" ? "page" : undefined}
          class={`inline-flex min-h-11 items-center rounded-sm px-2.5 py-1 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring ${
            locale === "en"
              ? "bg-secondary text-secondary-foreground"
              : "text-muted-foreground hover:text-foreground"
          }`}
        >
          EN
        </a>
      </div>

      <!-- CTA Escritorio -->
      <a
        href="#contact"
        class="hidden shrink-0 rounded-sm bg-primary px-4 py-2.5 text-sm font-medium whitespace-nowrap text-primary-foreground transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring sm:inline-flex"
      >
        {t.nav.cta}
      </a>

      <!-- Botón Hamburguesa (Móvil) -->
      <button
        id="menu-btn"
        type="button"
        aria-label="Toggle Menu"
        class="flex h-11 w-11 flex-col items-center justify-center gap-1 rounded-sm border border-border bg-background text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:hidden"
      >
        <span
          id="hamburger-line-1"
          class="h-0.5 w-4 bg-foreground transition-all duration-300"></span>
        <span
          id="hamburger-line-2"
          class="h-0.5 w-4 bg-foreground transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <!-- Menú desplegable Móvil -->
  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-16 left-0 w-full -translate-y-2 border-b border-border bg-background/95 px-6 py-6 opacity-0 backdrop-blur-xl transition-all duration-300 ease-in-out md:hidden lg:px-10"
  >
    <ul class="flex flex-col text-base">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-link flex min-h-11 items-center text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-col gap-4 border-t border-border pt-6">
      <a
        href="#contact"
        class="mobile-link flex min-h-11 items-center justify-center rounded-sm bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t.nav.cta}
      </a>
    </div>
  </div>
</header>

<nav
  class="index-rail fixed top-1/2 left-6 z-40 hidden -translate-y-1/2 xl:block"
>
  <ul class="flex flex-col gap-1">
    <li>
      <a
        href="#about"
        class="index-link inline-flex min-h-10 items-center py-1.5 text-xs tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t.nav.about}
      </a>
    </li>
    <li>
      <a
        href="#services"
        class="index-link inline-flex min-h-10 items-center py-1.5 text-xs tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t.nav.services}
      </a>
    </li>
    <li>
      <a
        href="#cases"
        class="index-link inline-flex min-h-10 items-center py-1.5 text-xs tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t.nav.cases}
      </a>
    </li>
    <li>
      <a
        href="#experience"
        class="index-link inline-flex min-h-10 items-center py-1.5 text-xs tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t.experience.title}
      </a>
    </li>
    <li>
      <a
        href="#projects"
        class="index-link inline-flex min-h-10 items-center py-1.5 text-xs tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t.nav.projects}
      </a>
    </li>
    <li>
      <a
        href="#skills"
        class="index-link inline-flex min-h-10 items-center py-1.5 text-xs tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t.nav.skills}
      </a>
    </li>
    <li>
      <a
        href="#contact"
        class="index-link inline-flex min-h-10 items-center py-1.5 text-xs tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t.nav.contact}
      </a>
    </li>
  </ul>
</nav>

<script>
  const menuBtn = document.getElementById("menu-btn")
  const mobileMenu = document.getElementById("mobile-menu")
  const line1 = document.getElementById("hamburger-line-1")
  const line2 = document.getElementById("hamburger-line-2")
  const mobileLinks = document.querySelectorAll(".mobile-link")

  let isOpen = false

  function toggleMenu() {
    isOpen = !isOpen
    if (isOpen) {
      mobileMenu?.classList.remove(
        "opacity-0",
        "pointer-events-none",
        "-translate-y-2"
      )
      mobileMenu?.classList.add(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0"
      )
      if (line1 && line2) {
        line1.style.transform = "rotate(45deg) translate(0px, 0px)"
        line2.style.transform = "rotate(-45deg) translate(0px, 0px)"
      }
    } else {
      mobileMenu?.classList.add(
        "opacity-0",
        "pointer-events-none",
        "-translate-y-2"
      )
      mobileMenu?.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0"
      )
      if (line1 && line2) {
        line1.style.transform = "translateY(-3.5px)"
        line2.style.transform = "translateY(3.5px)"
      }
    }
  }

  menuBtn?.addEventListener("click", toggleMenu)

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu()
    })
  })
</script>
