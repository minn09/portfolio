---
import { personalInfo } from "@/data/personal"
import { featuredProjects } from "@/data/projects"
import { getTranslations, type Locale } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
const currentYear = new Date().getFullYear()
---

<footer
  class="relative overflow-hidden border-t border-border bg-background py-16 text-muted-foreground"
>
  <div class="relative mx-auto max-w-[1200px] px-6 lg:px-10">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Columna Izquierda: Info Personal & Contacto (7 columnas) -->
      <div class="space-y-8 lg:col-span-7">
        <div class="space-y-3">
          <h2
            class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl"
          >
            {personalInfo.name}
          </h2>
          <div
            class="inline-flex items-center rounded-sm border border-border px-3 py-1 text-xs text-muted-foreground"
          >
            {t.common.roleTitle}
          </div>
          <p class="max-w-xl text-base leading-relaxed text-muted-foreground">
            {t.footer.bio}
          </p>
        </div>

        <!-- Enlaces de Contacto en Grid/Píldoras -->
        <div class="space-y-3">
          <h3 class="text-sm font-medium text-foreground">
            {t.footer.contactTitle}
          </h3>
          <div class="flex flex-wrap gap-3">
            <!-- Email -->
            <a
              href={`mailto:${personalInfo.email}`}
              class="group flex min-h-11 items-center gap-2.5 rounded-sm border border-border px-4 py-2.5 text-sm font-medium text-foreground transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-muted-foreground"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>Email</span>
            </a>

            <!-- GitHub -->
            <a
              href={personalInfo.github}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-h-11 items-center gap-2.5 rounded-sm border border-border px-4 py-2.5 text-sm font-medium text-foreground transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="text-muted-foreground"
              >
                <path
                  d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                ></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
              <span>GitHub</span>
            </a>

            <!-- LinkedIn -->
            <a
              href={personalInfo.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-h-11 items-center gap-2.5 rounded-sm border border-border px-4 py-2.5 text-sm font-medium text-foreground transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-muted-foreground"
              >
                <path
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                ></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Proyectos Destacados (5 columnas) -->
      <div class="flex flex-col justify-between space-y-6 lg:col-span-5">
        <div class="space-y-4">
          <h3
            class="flex items-center gap-2 text-lg font-semibold text-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground"
              ><polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
              ></polygon></svg
            >
            {t.footer.featuredProjects}
          </h3>

          <div class="space-y-2.5">
            {
              featuredProjects.map((project) => (
                <a
                  href={project.demo || project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex min-h-11 items-center rounded-sm border border-border px-3.5 py-3 transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                >
                  <span class="text-sm font-medium text-foreground">
                    {project.title}
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <a
          href="#projects"
          class="inline-flex min-h-11 items-center justify-center rounded-sm border border-border px-5 py-3 text-sm font-medium text-foreground transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        >
          {t.footer.viewAllProjects}
        </a>
      </div>
    </div>

    <!-- Barra Inferior / Copyright -->
    <div
      class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 sm:flex-row"
    >
      <p class="text-xs text-muted-foreground">
        © {currentYear}
        {personalInfo.name}. All rights reserved.
      </p>
      <p class="text-center text-xs text-muted-foreground sm:text-right">
        {t.footer.dedication}
      </p>
    </div>
  </div>
</footer>
